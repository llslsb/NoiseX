# NoiseX 环境变量模板
# 复制为 .env 并填入实际值

# 数据库
DB_USERNAME=noisex
DB_PASSWORD=change_me_db_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# JWT
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# 加密
ENCRYPTION_KEY=change_me_encryption_key_32_bytes!

# WebSocket
WS_ALLOWED_ORIGINS=*

# 推送
PUSH_ENABLED=false
PUSH_APP_ID=
PUSH_CLIENT_ID=
PUSH_CLIENT_SECRET=

# Spring
SPRING_PROFILES_ACTIVE=prod
