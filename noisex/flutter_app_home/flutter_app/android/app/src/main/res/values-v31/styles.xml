<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统启动画面：图标必须是纯位图（inset XML 方案实测被 EMUI
         忽略并回退默认图标）。splash_icon_padded.png = 576×576 透明画布（恰为
         192dp 图标区 @3x，1:1 无缩放伪影）+ 居中 120px 小沙漏，视觉对齐鸿蒙端
         startWindow 原始小尺寸（TP 实测 ~130px）。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_padded</item>
        <!-- 与 values/styles.xml 保持一致（EMUI 0.7 压暗补偿） -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#0E0E15</item>
        <item name="android:navigationBarColor">#0E0E15</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <!-- 与 values/styles.xml 保持一致（EMUI 0.7 压暗补偿） -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#0E0E15</item>
        <item name="android:navigationBarColor">#0E0E15</item>
    </style>
</resources>
